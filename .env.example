APP_ENV=development
APP_VERSION=0.1.0
VITE_DEMO_MODE=false
# Public client configuration. No private credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Server only. Trusted infrastructure with ADC is preferred when available.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Existing Vercel deployments may retain this complete JSON credential binding:
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_CREDENTIAL_MODE=adc
# Local emulators only; use a demo-* project and loopback hosts.
# VITE_USE_FIREBASE_EMULATORS=true
# FIREBASE_USE_EMULATORS=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
