APP_ENV=development
APP_VERSION=0.1.0
# Initial UI mode only. Explicit demo entry remains available in live mode.
VITE_DEMO_MODE=true
# Public Firebase Web configuration (not service-account credentials):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server-only Firebase project and credentials. Never prefix these with VITE_.
FIREBASE_PROJECT_ID=
# Supply securely in server/deployment settings; never commit a private key.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Trusted infrastructure may alternatively provide Application Default Credentials.
